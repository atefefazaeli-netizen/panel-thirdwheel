# Base URL of the Thirdwheel API, including /api/v1. Leave empty to use the dev proxy (/api/v1)
# and the in-browser mock API.
VITE_API_URL=
# Where the dev server proxies /api to (only used by `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:3000
# 1 = always use the in-browser mock API (MSW), even when VITE_API_URL is set. A production build
# with 1 is a demo build: every screen shows "Demo data, not the real API". Never set it for real use.
VITE_API_MOCKS=
# 1 = write source maps (hidden: no sourceMappingURL) for an error tracker. Do not deploy *.map.
VITE_SOURCEMAP=
# Every VITE_ variable ends up in the public bundle: never put a secret in one.
