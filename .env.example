# Base URL of the Thirdwheel API, including /api/v1.
# Production builds REQUIRE it: https (http only for localhost, for a local preview).
# Development: leave empty for the in-browser mock API, or /api/v1 for the dev proxy.
VITE_API_URL=
# Where the dev server proxies /api to (only used by `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:3000
# Development only: 1 = always use the in-browser mock API (MSW), 0 = never.
# A production build refuses this variable whatever its value.
VITE_API_MOCKS=
# 1 = write source maps (hidden: no sourceMappingURL) for an error tracker. Do not deploy *.map.
VITE_SOURCEMAP=
# Every VITE_ variable ends up in the public bundle: never put a secret in one.
